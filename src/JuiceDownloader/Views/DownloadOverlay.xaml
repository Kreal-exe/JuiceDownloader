<UserControl x:Class="JuiceDownloader.Views.DownloadOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DownloadViewModel}">

    <Grid x:Name="Root" Background="{DynamicResource Brush.Overlay}">
        <Canvas x:Name="Confetti" IsHitTestVisible="False" ClipToBounds="True" />

        <Border x:Name="Card" Width="560" Padding="36,32" CornerRadius="24" Background="{DynamicResource Brush.CardSolid}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" />
                    <TranslateTransform x:Name="CardT" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="56" ShadowDepth="14" Opacity="0.5" Color="Black" />
            </Border.Effect>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ring -->
                    <Grid Width="112" Height="112">
                        <c:Arc StrokeThickness="9" Stroke="{DynamicResource Brush.Track}" StartAngle="0" EndAngle="360" />
                        <c:Arc x:Name="ValueArc" StrokeThickness="9" Stroke="{DynamicResource Brush.RingGradient}" StartAngle="0" EndAngle="0"
                               StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <c:Arc.Effect>
                                <DropShadowEffect Color="{DynamicResource Color.Accent}" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                            </c:Arc.Effect>
                        </c:Arc>
                        <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource Font.Display}" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding EndedClean, Converter={StaticResource BoolToVisInverse}}" />
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}"
                                   Visibility="{Binding EndedClean, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}" Style="{StaticResource H2}" FontSize="22" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding ProgressText, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding FilesText}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                                   Visibility="{Binding FilesText, Converter={StaticResource NullToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- what is on its way now -->
                <ItemsControl ItemsSource="{Binding ActiveFiles}" Margin="0,18,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- how it ended -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Str download.stoppedBody}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding WasStopped, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LyricsSummaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding LyricsSummaryText, Converter={StaticResource NullToVis}}" />
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Str download.failures}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Failures}" MaxHeight="150" Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FailureRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Reason}" Style="{StaticResource Caption}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Reason}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>

                <!-- while it runs -->
                <Button Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                        HorizontalAlignment="Right" Margin="0,24,0,0" MinWidth="110" Padding="18,11"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" FontSize="12" />
                        <TextBlock Text="{Binding StopText}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- when it is over -->
                <WrapPanel HorizontalAlignment="Right" Margin="0,24,0,0" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource GhostButton}" Content="{loc:Str download.showFolder}" Command="{Binding ShowFolderCommand}" Padding="18,11" Margin="0,0,10,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:Str download.retry}" Command="{Binding RetryCommand}" Padding="18,11" Margin="0,0,10,0"
                            Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:Str download.close}" Command="{Binding CloseCommand}" MinWidth="110" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
