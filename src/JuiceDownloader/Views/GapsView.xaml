<UserControl x:Class="JuiceDownloader.Views.GapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:GapsViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,6,32,14">
            <TextBlock Text="{loc:Str gaps.title}" Style="{StaticResource H1}" c:Entrance.Delay="0" />
            <TextBlock Text="{loc:Str gaps.subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" c:Entrance.Delay="0" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14" c:Entrance.Delay="60">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Str gaps.folder}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{loc:Str overview.change}" Command="{Binding ChangeFolderCommand}" IsEnabled="{Binding IsIdle}" Margin="16,0,10,0" />
                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="{loc:Str gaps.scan}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsIdle}" />
                    </Grid>
                    <TextBlock Text="{loc:Str gaps.notEnabled}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Lyrics.Enabled, Converter={StaticResource BoolToVisInverse}}" />
                </StackPanel>
            </Border>

            <!-- running -->
            <Grid Margin="4,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Arc StrokeThickness="2" Stroke="{DynamicResource Brush.Accent}" StartAngle="0" EndAngle="270" Width="14" Height="14"
                           StrokeStartLineCap="Round" StrokeEndLineCap="Round" c:Spin.IsActive="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="{loc:Str gaps.stop}" Command="{Binding StopCommand}" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="4,10,0,0"
                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,12,0,0"
                       Visibility="{Binding SummaryText, Converter={StaticResource NullToVis}}" />
            <TextBlock Text="{loc:Str gaps.empty}" Style="{StaticResource Muted}" Foreground="{DynamicResource Brush.Success}" Margin="4,6,0,0"
                       Visibility="{Binding IsClean, Converter={StaticResource BoolToVis}}" />

            <!-- the web -->
            <Grid Margin="4,12,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Str gaps.search.desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                               Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{loc:Str gaps.search}" Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearch}" />
            </Grid>
        </StackPanel>

        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" Padding="32,0,26,20">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GapRowVm}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding Folder}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding StatusText}"
                                           Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFound}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.WarningSoft}" VerticalAlignment="Center" MaxWidth="260">
                                <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindText}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
