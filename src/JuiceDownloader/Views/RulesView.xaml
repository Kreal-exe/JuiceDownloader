<UserControl x:Class="JuiceDownloader.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:RulesViewModel}">

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,6,32,12">
                <TextBlock Text="{loc:Str rules.title}" Style="{StaticResource H1}" c:Entrance.Delay="0" />
                <TextBlock Text="{loc:Str rules.subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" c:Entrance.Delay="0" />

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,14,20,4" c:Entrance.Delay="60">
                    <StackPanel>
                        <TextBlock Text="{loc:Str rules.preset}" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock Text="{loc:Str rules.preset.desc}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SubtleButton}" Content="{loc:Str rules.quick.unreleased}" Command="{Binding QuickUnreleasedCommand}" />
                                                        <Button Style="{StaticResource SubtleButton}" Content="{loc:Str rules.quick.released}" Command="{Binding QuickReleasedCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{loc:Str rules.from}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RuleSectionChip}">
                                    <ToggleButton Style="{StaticResource ToggleChip}" Content="{Binding Title}" IsChecked="{Binding IsOn}" Margin="0,0,6,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <UniformGrid Columns="2">
                            <c:SettingRow Glyph="&#xE8FD;" Title="{loc:Str rules.oneVersion}" Description="{loc:Str rules.oneVersion.desc}" Margin="0,0,16,0">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OneVersion}" />
                            </c:SettingRow>
                            <c:SettingRow Glyph="&#xE93C;" Title="{loc:Str rules.skipReleased}" Description="{loc:Str rules.skipReleased.desc}">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SkipReleased}" />
                            </c:SettingRow>
                            <c:SettingRow Glyph="&#xE7BA;" Title="{loc:Str rules.skipUnfinished}" Description="{loc:Str rules.skipUnfinished.desc}" Margin="0,0,16,0">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SkipUnfinished}" />
                            </c:SettingRow>
                            <c:SettingRow Glyph="&#xE8B7;" Title="{loc:Str rules.oneFolder}" Description="{Binding OneFolderDescription}">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OneFolder}" />
                            </c:SettingRow>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Grid Margin="4,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <c:Arc StrokeThickness="2" Stroke="{DynamicResource Brush.Accent}" StartAngle="0" EndAngle="270" Width="14" Height="14"
                                   StrokeStartLineCap="Round" StrokeEndLineCap="Round" c:Spin.IsActive="{Binding IsLoading}" />
                            <TextBlock Text="{loc:Str rules.loading}" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding SummaryText, Converter={StaticResource NullToVis}}" />
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="{Binding SkippedText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,12,0"
                                       Visibility="{Binding SkippedText, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding CopiesText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding CopiesText, Converter={StaticResource NullToVis}}" />
                        </WrapPanel>
                    </StackPanel>
                    <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownload}"
                            MouseEnter="OnDownloadEnter" MouseLeave="OnDownloadLeave" Click="OnDownloadClick" />
                    <Popup x:Name="DownloadPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=DownloadButton}" Placement="Bottom" AllowsTransparency="True" VerticalOffset="6" MouseLeave="OnDownloadLeave">
                        <Border Width="360" Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DownloadListTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10" />
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DownloadList}" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Brush.TextMuted}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" Padding="32,2,26,20" PreviewMouseRightButtonUp="OnRightClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RuleRowVm}">
                    <Grid Margin="{Binding Indent}">
                        <Border Cursor="Hand" ToolTip="{Binding Node.Path}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Height" Value="60" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="18,0" />
                                    <Setter Property="CornerRadius" Value="14" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVersion}" Value="True">
                                            <Setter Property="Height" Value="48" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ClickRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.PlayRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <c:TriCheck Style="{StaticResource VersionRadio}" IsChecked="{Binding IsPicked, Mode=OneWay}" Margin="0,0,14,0" ToolTip="{loc:Str rules.useVersion}"
                                            Visibility="{Binding IsVersion, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.PickVersionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVersion}" Value="True">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               Visibility="{Binding Line, Converter={StaticResource NullToVis}}" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center" Margin="0,0,12,0"
                                        Visibility="{Binding HasManyVersions, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding VersionsText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>

                                <Button Grid.Column="3" Content="{Binding PlayGlyph}" ToolTip="{loc:Str player.playable}" Margin="0,0,12,0"
                                        Command="{Binding DataContext.PlayRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="4" Content="&#xE896;" ToolTip="{loc:Str library.downloadOne}" Margin="0,0,12,0"
                                        Command="{Binding DataContext.DownloadRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="68" TextAlignment="Right" />

                                <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="{Binding ChevronGlyph}" Margin="8,0,0,0"
                                        Visibility="{Binding HasManyVersions, Converter={StaticResource BoolToHidden}}"
                                        Command="{Binding DataContext.ClickRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
