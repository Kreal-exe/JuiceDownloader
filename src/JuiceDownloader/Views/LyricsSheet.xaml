<UserControl x:Class="JuiceDownloader.Views.LyricsSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:LyricsSheetViewModel}"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">

    <Grid Background="{DynamicResource Brush.Overlay}">
        <Grid.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}" />
        </Grid.InputBindings>
        <Border Width="560" MaxHeight="600" Margin="24" Padding="32,28" CornerRadius="22" Background="{DynamicResource Brush.CardSolid}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnCardClick" c:Entrance.Replay="{Binding IsVisible}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="56" ShadowDepth="14" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="22" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding Note}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Words}" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                </ScrollViewer>
                <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="{loc:Str download.close}" Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right" MinWidth="110" Margin="0,18,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
