<UserControl x:Class="JuiceDownloader.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
             c:Entrance.Replay="{Binding IsVisible}">

    <Border Style="{StaticResource Card}" Margin="32,8,26,16" Padding="14,8" CornerRadius="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="{loc:Str player.previous}" />
            <Button Grid.Column="1" Style="{StaticResource PlayButton}" Width="38" Height="38" FontSize="14" Margin="4,0" Content="{Binding PlayGlyph}" Command="{Binding ToggleCommand}" ToolTip="{Binding PlayTip}" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}" ToolTip="{loc:Str player.next}" />

            <!-- the name is one button: it opens what plays next. While the list is open a click outside closes it, and must not open it again. -->
            <Border x:Name="TitleArea" Grid.Column="3" Margin="6,0,10,0" Padding="8,5" CornerRadius="10" Cursor="Hand" ToolTip="{loc:Str player.queue.show}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsQueueOpen}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleQueueCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ChevronGlyph}" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <Popup Grid.Column="3" IsOpen="{Binding IsQueueOpen}" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=TitleArea}" Placement="Top" VerticalOffset="-8" PopupAnimation="Fade">
                <Border Width="460" Margin="12" CornerRadius="16" Padding="0,12,0,8" Background="{DynamicResource Brush.CardSolid}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.3" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:Str player.queue}" FontSize="15" FontWeight="SemiBold" Margin="18,0" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding QueueLine}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="18,2,18,8" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Queue}" MaxHeight="342" Padding="8,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QueueRow}">
                                    <Border Height="38" Padding="10,0,12,0" CornerRadius="10" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.PlayQueueRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>

            <TextBlock Grid.Column="4" Text="{Binding ElapsedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider Grid.Column="5" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" />
            <TextBlock Grid.Column="6" Text="{Binding TotalText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,10,0" />

            <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#xE8BD;" Command="{Binding OpenLyricsCommand}" ToolTip="{loc:Str menu.row.lyrics}" />
            <Button Grid.Column="8" Style="{StaticResource IconButton}" Content="{Binding DownloadGlyph}" Command="{Binding DownloadTrackCommand}" ToolTip="{Binding DownloadTip}" Margin="0,0,8,0" />

            <Button Grid.Column="9" Style="{StaticResource IconButton}" Content="{Binding SpeakerGlyph}" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding SpeakerTip}" />
            <Slider Grid.Column="10" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" Value="{Binding Volume}" ToolTip="{loc:Str player.volume}" />

            <Button Grid.Column="11" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CloseCommand}" Margin="8,0,0,0" ToolTip="{loc:Str player.close}" />
        </Grid>
    </Border>
</UserControl>
