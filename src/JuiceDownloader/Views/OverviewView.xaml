<UserControl x:Class="JuiceDownloader.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:v="clr-namespace:JuiceDownloader.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Style="{StaticResource SearchBox}" Margin="32,6,32,12" Tag="{loc:Str overview.search}"
                 Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVis}}" />

        <!-- what the search found, in the whole catalog -->
        <Grid Grid.Row="1" DataContext="{Binding Search}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="36,0,36,10">
                <TextBlock Text="{Binding ResultsText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{loc:Str library.select}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str library.selectAll}" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str library.selectNone}" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
            </Grid>
            <v:SectionView Grid.Row="1" ShowHeader="False" />
        </Grid>

    <ScrollViewer x:Name="Page" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Search.IsSearching}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>
        <StackPanel Margin="26,6,26,28" MaxWidth="1320">

            <!-- ───────── the API could not be reached, and there is no last catalog to show ───────── -->
            <Border Style="{StaticResource Card}" Padding="32,30" Margin="6,0"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" c:Entrance.Replay="{Binding IsFailed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="15" Background="{DynamicResource Brush.DangerSoft}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource Brush.Danger}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str catalog.failed}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FailureText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{loc:Str catalog.retry}" Command="{Binding RefreshCatalogCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisInverse}}">

                <!-- ───────── hero ───────── -->
                <Border Style="{StaticResource Card}" Padding="32,30" Margin="6,0" c:Entrance.Delay="0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- ring: the selected share of the catalog, or a spinning segment while the catalog loads (OverviewView.xaml.cs) -->
                            <Grid Width="204" Height="204">
                                <c:Arc StrokeThickness="14" Stroke="{DynamicResource Brush.Track}" StartAngle="0" EndAngle="360" />
                                <c:Arc x:Name="ValueArc" StrokeThickness="14" Stroke="{DynamicResource Brush.RingGradient}" StartAngle="0" EndAngle="0"
                                       StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <c:Arc.RenderTransform>
                                        <RotateTransform x:Name="RingRotate" />
                                    </c:Arc.RenderTransform>
                                    <c:Arc.Effect>
                                        <DropShadowEffect Color="{DynamicResource Color.Accent}" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                                    </c:Arc.Effect>
                                </c:Arc>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock c:Counter.Bytes="{Binding RingBytes}" c:Counter.Part="Number" c:Counter.Duration="900"
                                                   FontFamily="{StaticResource Font.Display}" FontSize="42" FontWeight="Bold" />
                                        <TextBlock c:Counter.Bytes="{Binding RingBytes}" c:Counter.Part="Unit" c:Counter.Duration="900"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,9" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RingCaption}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding RingFilesText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- what the catalog holds -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Str overview.title}" Style="{StaticResource H1}" />
                                <TextBlock Text="{loc:Str catalog.loading}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Str overview.catalog}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                                    <TextBlock c:Counter.Bytes="{Binding CatalogBytes}" FontFamily="{StaticResource Font.Display}" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CatalogFilesText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Text="{loc:Str overview.nothingSelected}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"
                                           Visibility="{Binding HasNothingSelected, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{loc:Str catalog.offline}" Style="{StaticResource Caption}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- the action -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="220">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding Download.StartCommand}" IsEnabled="{Binding CanDownload}"
                                        c:Pulse.IsActive="{Binding CanDownload}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource Brush.TextOnAccent}" />
                                        <TextBlock Text="{Binding DownloadButtonText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- where it goes -->
                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock Grid.Column="1" Text="{loc:Str overview.folder}" FontSize="13" FontWeight="SemiBold" Margin="10,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Settings.Destination}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Settings.Destination}" />
                                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="{loc:Str overview.change}" Command="{Binding Settings.ChangeFolderCommand}" Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ───────── sections ───────── -->
                <Grid Margin="10,30,10,12" c:Entrance.Delay="90">
                    <TextBlock Text="{loc:Str overview.sections}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <c:SegmentBar ItemsSource="{Binding Sections}" WeightPath="SelectedBytes" BrushPath="Brush" Track="{DynamicResource Brush.Track}" Height="12" Margin="10,0,10,12" c:Entrance.Delay="110"
                              Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" />

                <Border Style="{StaticResource Card}" Margin="6,0,6,10" Padding="18,14" CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:TriCheck Style="{StaticResource Check}" IsChecked="{Binding UnreleasedState, Mode=OneWay}" Command="{Binding ToggleUnreleasedCommand}" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Str overview.allUnreleased}" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str overview.allUnreleased.desc}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding UnreleasedSize}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Sections}" c:Entrance.Stagger="40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SectionViewModel}">
                            <Border Style="{StaticResource CardHover}" Margin="6,0,6,10" Padding="18,14" CornerRadius="16" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:TriCheck Style="{StaticResource Check}" IsChecked="{Binding CheckState, Mode=OneWay}" Command="{Binding ToggleCommand}" Margin="0,0,16,0" />
                                    <Border Grid.Column="1" Style="{StaticResource IconTileBounce}" Width="38" Height="38" CornerRadius="11" Background="{Binding SoftBrush}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" Foreground="{Binding Brush}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="14,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="96">
                                        <TextBlock c:Counter.Bytes="{Binding Size}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding FilesText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
