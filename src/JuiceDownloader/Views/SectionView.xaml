<UserControl x:Class="JuiceDownloader.Views.SectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:vm="clr-namespace:JuiceDownloader.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SectionViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel x:Name="Header" Margin="32,6,32,14" c:Entrance.Delay="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,340,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox Style="{StaticResource SearchBox}" Width="320" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Tag="{loc:Str library.search}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,180,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{loc:Str library.select}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str library.selectAll}" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str library.selectNone}" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- The whole section can be tens of thousands of lines: virtualized, and every line is a fixed height so the scrollbar is honest. -->
        <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" Padding="32,2,26,28" PreviewMouseRightButtonUp="OnRightClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LibraryRowVm}">
                    <Grid Margin="{Binding Indent}">
                        <Border Cursor="Hand" ToolTip="{Binding Path}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Height" Value="66" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="18,0" />
                                    <Setter Property="CornerRadius" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTop}" Value="False">
                                            <Setter Property="Height" Value="46" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="Padding" Value="18,0" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.CardHover}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorderHover}" />
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsTop}" Value="False" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ClickRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.PlayRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- lands on this row after "Show in its folder" -->
                                <Border Grid.ColumnSpan="7" Margin="-18,0" CornerRadius="12" Background="{DynamicResource Brush.Accent}" IsHitTestVisible="False" Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard FillBehavior="Stop">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.4" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <c:TriCheck Style="{StaticResource Check}" IsChecked="{Binding CheckState, Mode=OneWay}" Margin="0,0,16,0"
                                            Command="{Binding DataContext.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />

                                <Border Grid.Column="1" Background="{Binding KindSoftBrush}" VerticalAlignment="Center" ToolTip="{Binding ActionTip}" ToolTipService.IsEnabled="{Binding HasAction}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.MarkRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.IgnoreRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="38" />
                                            <Setter Property="Height" Value="38" />
                                            <Setter Property="CornerRadius" Value="11" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTop}" Value="False">
                                                    <Setter Property="Width" Value="30" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="CornerRadius" Value="9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding KindBrush}" />
                                </Border>

                                <StackPanel Grid.Column="2" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="14.5" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTop}" Value="False">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Line, Converter={StaticResource NullToVis}}" />
                                </StackPanel>

                                <!-- shown on hover, and always on the playing row; hidden, not collapsed, so the sizes stay in a column -->
                                <Button Grid.Column="3" Content="{Binding PlayGlyph}" ToolTip="{Binding ActionTip}" Margin="0,0,12,0"
                                        Command="{Binding DataContext.PlayRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasAction}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="4" Content="&#xE896;" ToolTip="{loc:Str library.downloadOne}" Margin="0,0,12,0"
                                        Command="{Binding DataContext.DownloadRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="72" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTop}" Value="False">
                                                    <Setter Property="FontSize" Value="13" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="{Binding ChevronGlyph}" Margin="12,0,0,0"
                                        Visibility="{Binding IsFolder, Converter={StaticResource BoolToHidden}}"
                                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- nothing to list -->
        <TextBlock Grid.Row="1" Text="{loc:Str library.noResults}" Style="{StaticResource Muted}" Margin="36,12,32,0" VerticalAlignment="Top"
                   Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}" />
        <StackPanel Grid.Row="1" Margin="36,12,32,0" VerticalAlignment="Top"
                    Visibility="{Binding Owner.HasNoCatalogYet, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Owner.NoCatalogText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            <Button Style="{StaticResource GhostButton}" Content="{loc:Str catalog.retry}" Command="{Binding Owner.RefreshCatalogCommand}"
                    HorizontalAlignment="Left" Margin="0,12,0,0"
                    Visibility="{Binding Owner.IsFailed, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
