<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="JuiceDownloader.Views.PreviewSheet">
    <Grid Background="{DynamicResource Brush.Overlay}">
        <Border Classes="sheet" Margin="20" Padding="22,18" CornerRadius="24" Background="{DynamicResource Brush.CardSolid}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" BoxShadow="0 18 56 0 #80000000">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Name}" Classes="h2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Place}" Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                        <CheckBox Classes="check" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding ToggleSelectCommand}" />
                        <TextBlock Text="{Binding SelectText}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}" ToolTip.Tip="{loc:Str preview.previous}">
                        <mi:MaterialIcon Kind="ChevronLeft" Width="22" Height="22" />
                    </Button>
                    <TextBlock Grid.Column="3" Text="{Binding CountText}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
                    <Button Grid.Column="4" Classes="icon" Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}" ToolTip.Tip="{loc:Str preview.next}">
                        <mi:MaterialIcon Kind="ChevronRight" Width="22" Height="22" />
                    </Button>
                    <Button Grid.Column="5" Classes="icon" Margin="10,0,0,0" Command="{Binding CloseCommand}" ToolTip.Tip="{loc:Str preview.close}">
                        <mi:MaterialIcon Kind="Close" Width="19" Height="19" />
                    </Button>
                </Grid>

                <Panel Grid.Row="1" Margin="0,14,0,0">
                    <Image Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding HasImage}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <Border CornerRadius="14" Background="{DynamicResource Brush.Inset}" Padding="14,10" IsVisible="{Binding HasText}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding Text}" FontFamily="Menlo, DejaVu Sans Mono, Liberation Mono, monospace" FontSize="12.5" LineHeight="19" />
                        </ScrollViewer>
                    </Border>
                    <Border Classes="tile" Width="72" Height="72" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.AccentSoft}" IsVisible="{Binding IsVideo}">
                        <mi:MaterialIcon Kind="MovieOpenOutline" Width="34" Height="34" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsLoading}">
                        <c:RingArc Width="34" Height="34" StrokeThickness="4" Stroke="{DynamicResource Brush.Accent}" IsSpinning="{Binding IsLoading}" />
                        <TextBlock Text="{loc:Str preview.loading}" Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasMessage}" />
                </Panel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
