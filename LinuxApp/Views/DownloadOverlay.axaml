<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="JuiceDownloader.Views.DownloadOverlay">
    <Grid Background="{DynamicResource Brush.Overlay}">
        <Border Classes="sheet" Width="560" Padding="36,32" CornerRadius="24" Background="{DynamicResource Brush.CardSolid}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 18 56 0 #80000000">
            <StackPanel>
                <!-- title -->
                <StackPanel Orientation="Horizontal">
                    <Panel>
                        <Border Classes="tile" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}" IsVisible="{Binding !IsOver}">
                            <c:RingArc Width="22" Height="22" StrokeThickness="3" Stroke="{DynamicResource Brush.Accent}" IsSpinning="{Binding !IsOver}" />
                        </Border>
                        <Border Classes="tile" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.SuccessSoft}" IsVisible="{Binding IsClean}">
                            <mi:MaterialIcon Kind="CheckBold" Width="22" Height="22" Foreground="{DynamicResource Brush.Success}" />
                        </Border>
                        <Border Classes="tile" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.WarningSoft}" IsVisible="{Binding IsTroubled}">
                            <mi:MaterialIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Warning}" />
                        </Border>
                    </Panel>
                    <TextBlock Text="{Binding TitleText}" Classes="h2" FontSize="22" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ring and numbers -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,22,0,0">
                    <Panel Width="124" Height="124">
                        <Ellipse Stroke="{DynamicResource Brush.Track}" StrokeThickness="10" />
                        <c:RingArc StrokeThickness="10" Stroke="{DynamicResource Brush.RingGradient}" Sweep="{Binding RingAngle}" IsSpinning="{Binding IsGettingLyrics}" />
                        <TextBlock Text="{Binding PercentText}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BytesText}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FilesText}" Classes="muted" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" IsVisible="{Binding IsRunning}">
                            <TextBlock Text="{Binding SpeedText}" Classes="muted" />
                            <TextBlock Text="{Binding RemainingText}" Classes="muted" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- what is on its way -->
                <ItemsControl ItemsSource="{Binding Active}" Margin="0,16,0,0" IsVisible="{Binding IsRunning}" MinHeight="56">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="caption" Margin="0,2" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- how it went -->
                <TextBlock Text="{Binding SummaryText}" Classes="muted" TextWrapping="Wrap" Margin="0,18,0,0" IsVisible="{Binding IsOver}" />
                <StackPanel IsVisible="{Binding HasFailures}" Margin="0,14,0,0">
                    <TextBlock Text="{loc:Str download.failures}" Classes="caption" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border CornerRadius="12" Background="{DynamicResource Brush.Inset}" Padding="12,8">
                        <ListBox Classes="rows" MaxHeight="150" ItemsSource="{Binding Failures}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="caption" Foreground="{DynamicResource Brush.Warning}" Margin="12,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <!-- buttons -->
                <Panel Margin="0,24,0,0">
                    <Button Classes="ghost" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                            HorizontalAlignment="Right" MinWidth="110" Padding="18,11" IsVisible="{Binding IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Stop" Width="14" Height="14" />
                            <TextBlock Text="{Binding StopText}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" IsVisible="{Binding IsOver}">
                        <Button Classes="ghost" Content="{loc:Str download.showFolder}" Command="{Binding ShowFolderCommand}" Padding="18,11" />
                        <Button Classes="ghost" Content="{loc:Str download.retry}" Command="{Binding RetryCommand}" Padding="18,11" IsVisible="{Binding HasFailures}" />
                        <Button Classes="primary" Content="{loc:Str download.close}" Command="{Binding CloseCommand}" MinWidth="110" Padding="22,11" />
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Border>
        <c:Confetti x:Name="Burst" />
    </Grid>
</UserControl>
