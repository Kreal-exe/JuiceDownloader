<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JuiceDownloader.Localization"
             xmlns:v="clr-namespace:JuiceDownloader.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:c="clr-namespace:JuiceDownloader.Controls"
             x:Class="JuiceDownloader.Views.AboutView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,6,32,28" MaxWidth="820">
            <Border Classes="card" Padding="30,28">
                <Grid ColumnDefinitions="Auto,*">
                    <Panel Width="84" Height="84" VerticalAlignment="Top">
                        <Border CornerRadius="24" Background="{DynamicResource Brush.AccentGradient}" Opacity="0.55" Margin="4,10,4,-2">
                            <Border.Effect>
                                <BlurEffect Radius="28" />
                            </Border.Effect>
                        </Border>
                        <v:Logo Width="84" Height="84" />
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="26,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{loc:Str app.name}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Classes="pill" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center" Padding="12,4">
                                <TextBlock Text="{Binding VersionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Str app.tagline}" FontSize="14" FontWeight="Medium" Margin="0,8,0,0" />
                        <TextBlock Text="{loc:Str about.description}" Classes="muted" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                        <WrapPanel Margin="-6,10,0,0">
                            <Button Classes="primary" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/Kreal-exe/JuiceDownloader" Margin="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="Github" Width="17" Height="17" />
                                    <TextBlock Text="{loc:Str about.github}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" Content="{loc:Str about.issues}" Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/Kreal-exe/JuiceDownloader/issues" Margin="6" Padding="18,12" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card rise" Margin="0,12,0,0" Padding="24,18,24,10">
                <StackPanel>
                    <TextBlock Text="{loc:Str about.catalog}" Classes="h2" Margin="0,0,0,4" />
                    <c:SettingRow Glyph="MusicNoteOutline" Title="{loc:Str about.catalog.files}" Description="{Binding CatalogLine}" />
                    <c:SettingRow Glyph="TextBoxOutline" Title="{loc:Str lyrics.title}" Description="{Binding Lyrics.StatsText}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border Classes="card rise" Margin="0,12,0,0" Padding="24,18,24,10">
                <StackPanel>
                    <TextBlock Text="{loc:Str about.files}" Classes="h2" Margin="0,0,0,4" />
                    <c:SettingRow Glyph="FolderDownloadOutline" Title="{loc:Str settings.folder}" Description="{Binding Settings.Destination}">
                        <Button Classes="ghost" Content="{loc:Str about.open}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding Settings.Destination}" />
                    </c:SettingRow>
                    <c:SettingRow Glyph="CogOutline" Title="{loc:Str about.files.data}" Description="{Binding SettingsFolder}" BorderThickness="0">
                        <Button Classes="ghost" Content="{loc:Str about.open}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SettingsFolder}" />
                    </c:SettingRow>
                </StackPanel>
            </Border>

            <Border Classes="card rise" Margin="0,12,0,0" Padding="24,18,24,10">
                <StackPanel>
                    <TextBlock Text="{loc:Str about.sources}" Classes="h2" Margin="0,0,0,4" />
                    <c:SettingRow Glyph="MusicBoxOutline" Title="{loc:Str about.source}" Description="{loc:Str about.source.desc}">
                        <Button Classes="ghost" Content="{loc:Str about.source.open}" Command="{Binding OpenUrlCommand}" CommandParameter="https://juicewrldapi.com" />
                    </c:SettingRow>
                    <c:SettingRow Glyph="Web" Title="{loc:Str about.web}" Description="{loc:Str about.web.desc}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Str about.footer}" Classes="caption" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
